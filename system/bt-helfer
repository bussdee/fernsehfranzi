#!/bin/bash
# FernsehFranzi 4.1 (6.9.35: Koppeln mit Agent) - Bluetooth für die Eltern-Seite. Läuft als root über die enge sudo-Regel.
# Erlaubt sind genau diese Aufrufe (MAC-Adresse wird geprüft):
#   bt-helfer liste                gekoppelte Geräte:  MAC<TAB>Name<TAB>verbunden(ja/nein)<TAB>Akku(% oder leer)
#   bt-helfer suchen               12 s suchen, dann alle bekannten Geräte: MAC<TAB>Name
#   bt-helfer koppeln  <MAC>       koppeln, vertrauen, verbinden
#   bt-helfer verbinden <MAC> | trennen <MAC> | entfernen <MAC>
# Installiert von install/install.sh nach /usr/local/lib/fernsehfranzi/bt-helfer.
set -euo pipefail
export LC_ALL=C
aktion="${1:-}"
mac="${2:-}"

mac_pruefen() {
  [[ "$mac" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]] || { echo "Ungültige Geräte-Adresse." >&2; exit 2; }
}

zeile() {  # MAC<TAB>Name<TAB>verbunden<TAB>Akku
  local info name verbunden akku
  info="$(bluetoothctl info "$1" 2>/dev/null || true)"
  name="$(sed -n 's/^[[:space:]]*Name: //p' <<<"$info" | head -n 1)"
  verbunden="$(sed -n 's/^[[:space:]]*Connected: //p' <<<"$info" | head -n 1)"
  akku="$(sed -n 's/^[[:space:]]*Battery Percentage: .*(\([0-9]*\)).*/\1/p' <<<"$info" | head -n 1)"
  printf '%s\t%s\t%s\t%s\n' "$1" "${name//$'\t'/ }" "$([ "$verbunden" = yes ] && echo ja || echo nein)" "$akku"
}

case "$aktion" in
  liste)
    bluetoothctl power on > /dev/null 2>&1 || true
    bluetoothctl devices Paired | sed -n 's/^Device \([0-9A-F:]\{17\}\) .*/\1/p' | while read -r m; do zeile "$m"; done
    ;;
  suchen)
    bluetoothctl power on > /dev/null 2>&1 || true
    bluetoothctl --timeout 12 scan on > /dev/null 2>&1 || true
    bluetoothctl devices | sed -n 's/^Device \([0-9A-F:]\{17\}\) \(.*\)$/\1\t\2/p'
    ;;
  koppeln)
    # 6.9.35: in EINER bluetoothctl-Sitzung mit Agent (sonst bestätigt niemand die Kopplung und die Box lehnt ab),
    # Pi dabei koppelbar und suchend; ein halber alter Eintrag (vertraut, aber nicht gekoppelt) wird vorher entfernt.
    # Am Ende wird geprüft, ob wirklich gekoppelt ist - vorher kam auch bei Misserfolg „ok“ zurück.
    mac_pruefen
    bluetoothctl power on > /dev/null 2>&1 || true
    if ! bluetoothctl info "$mac" 2>/dev/null | grep -q "Paired: yes"; then
      bluetoothctl remove "$mac" > /dev/null 2>&1 || true
    fi
    {
      echo "agent NoInputNoOutput"; echo "default-agent"; echo "pairable on"; echo "scan on"
      sleep 8
      echo "pair $mac"; sleep 14
      echo "trust $mac"; echo "connect $mac"; sleep 8
      echo "scan off"; echo "pairable off"; echo "quit"
    } | bluetoothctl > /dev/null 2>&1 || true
    if ! bluetoothctl info "$mac" 2>/dev/null | grep -q "Paired: yes"; then
      echo "Koppeln hat nicht geklappt. Ist die Box im Kopplungsmodus (blinkt)? Box kurz aus- und einschalten und nochmal versuchen." >&2
      exit 1
    fi
    bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes" || bluetoothctl --timeout 15 connect "$mac" > /dev/null 2>&1 || true
    echo "gekoppelt"
    ;;
  verbinden) mac_pruefen; bluetoothctl --timeout 15 connect "$mac" ;;
  trennen)   mac_pruefen; bluetoothctl disconnect "$mac" ;;
  entfernen) mac_pruefen; bluetoothctl remove "$mac" ;;
  *) echo "Aufruf: bt-helfer liste|suchen|koppeln|verbinden|trennen|entfernen [MAC]" >&2; exit 2 ;;
esac
