# FernsehFranzi - RetroPie auf einer eigenen Konsole (seit 2.5)
#
# EmulationStation und RetroArch zeichnen direkt ueber KMS und brauchen ein
# echtes Terminal. Deshalb laufen sie hier auf tty8 mit eigener Login-Sitzung
# (Geraeterechte, Ton ueber PipeWire) - ohne X11/Wayland, ohne Display-Variablen.
# Der Desktop mit der Startseite bleibt auf seiner Konsole und ist nach dem
# Beenden sofort wieder da (Wechsel per chvt, siehe fernsehfranzi-vt.sh).
# tty8 liegt hinter den automatisch belegten Konsolen 1-6: Dort startet logind
# keinen Login-Bildschirm dazwischen.
# Gestartet wird nur vom Hub-Server (sudo-Regel sudoers.d/fernsehfranzi).
[Unit]
Description=FernsehFranzi - RetroPie auf eigener Konsole (tty8)
After=systemd-user-sessions.service

[Service]
Type=simple
User=@BENUTZER@
PAMName=login
WorkingDirectory=~
TTYPath=/dev/tty8
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=TERM=linux
UnsetEnvironment=DISPLAY WAYLAND_DISPLAY SDL_VIDEODRIVER
ExecStartPre=+/usr/local/lib/fernsehfranzi/vt.sh hin 8
# Seit 3.2.2: bei jedem Start wieder Kiosk-Modus. Mit dem Entsperr-Code freigeschaltet (z. B. für den
# Scraper) bleibt EmulationStation also nur bis zum Beenden offen. "-": fehlt die Datei, startet ES trotzdem.
ExecStartPre=-/usr/bin/sed -i -e 's|<string name="UIMode" value="[^"]*" />|<string name="UIMode" value="Kiosk" />|' /opt/retropie/configs/all/emulationstation/es_settings.cfg
ExecStart=/usr/bin/emulationstation
ExecStopPost=+/usr/local/lib/fernsehfranzi/vt.sh zurueck
TimeoutStopSec=15
Restart=no
